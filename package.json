{
  "name": "momenty-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Автотесты (API + UI) для приложения «Моменты» на Playwright + TypeScript",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "test": "node scripts/bootstrap.mjs && playwright test",
    "test:api": "node scripts/bootstrap.mjs && playwright test --project=api",
    "test:ui": "node scripts/bootstrap.mjs && playwright test --project=mobile-chromium",
    "test:headed": "node scripts/bootstrap.mjs && playwright test --project=mobile-chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "author": "Aleksey Moliboga (holyboga)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holyboga/momenty-tests.git"
  }
}
